{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voltDesktopBeta",
  "version": "0.3.0",
  "identifier": "com.mickeyperry.volt",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "node ../tools/mkdesktop.js",
    "beforeBuildCommand": "node ../tools/mkdesktop.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "voltDesktopBeta",
        "url": "index.html",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Mickey Perry",
    "copyright": "© Mickey Perry",
    "category": "Music",
    "shortDescription": "voltDesktopBeta — tracker / DAW",
    "longDescription": "voltDesktopBeta — a tracker and DAW in one file, with a native audio engine (ASIO/WASAPI) and VST2/VST3 hosting.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
